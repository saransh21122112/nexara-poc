# Which backend powers the agents: anthropic | openai | claude_subscription
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# claude_subscription: uses your own `claude login` session via the local CLI. Local demo only.
CLAUDE_SUBSCRIPTION_MODEL=

# Demo-only password for /factory (NOT production security)
FACTORY_PASSWORD=nexara-demo

# Docker + claude_subscription only: token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
