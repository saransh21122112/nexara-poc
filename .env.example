# Which backend powers the agents: anthropic | openai | claude_subscription
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# claude_subscription: uses your own `claude login` session via the local CLI. Local demo only.
CLAUDE_SUBSCRIPTION_MODEL=

# Demo-only password for /factory (NOT production security)
FACTORY_PASSWORD=nexara-demo

# Docker + claude_subscription only: token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# --- Customer repo delivery (GitHub) ---
# Account (user or org) that will own the private customer repos, and a token that can create repos there.
# A classic PAT with the `repo` scope works. Keep the token only here / in Render's dashboard; never commit it.
GITHUB_OWNER=
GITHUB_TOKEN=
# Optional: shown in each customer repo's SUPPORT.md
SUPPORT_EMAIL=

# --- Email (confirmation links for requesters) ---
# Any provider's SMTP works (Gmail app password, Amazon SES, Resend, Mailgun ...). MAIL_MODE=log prints messages (with links) to the
# server log instead of sending: local development only. Without any of this, requests stay unverified and staff must verify manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nexara AI <noreply@yourdomain.example>
# Base URL used in the emailed link (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_URL=
# MAIL_MODE=log

# Set to false ONLY while you have no SMTP: delivery then works without email confirmation (the factory warns on every delivery).
# REQUIRE_EMAIL_VERIFICATION=true

# Request-form AI assistant (public endpoint that spends the configured provider's quota)
# ASSIST_PER_HOUR_PER_IP=10
# ASSIST_PER_DAY=200
